# AIra – environment variables (optional)
# Copy to .env and set values for production; app works without .env using fallbacks.

# Firebase (see src/lib/firebase.ts)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# AI Backend Services (required for AI quiz, teaching content, etc.)
# For Vercel: add the same variables in Project → Settings → Environment Variables
# (Production + Preview), then redeploy — VITE_* keys are baked in at build time.
#
# Groq (recommended for Chat Panel — fast, OpenAI-compatible): https://console.groq.com
# When set, Groq is tried first for text chat and document Q&A; vision uses Groq vision model if available.
VITE_GROQ_API_KEY=
# Optional overrides (defaults are strong for tutoring)
# VITE_GROQ_MODEL=llama-3.3-70b-versatile
# VITE_GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
VITE_OPENROUTER_API_KEY=
VITE_MISTRAL_API_KEY=
VITE_DEEPSEEK_API_KEY=
VITE_SARVAM_API_KEY=
